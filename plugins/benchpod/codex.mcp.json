{
  "mcpServers": {
    "benchpod": {
      "command": "./bin/benchpod-mcp",
      "cwd": ".",
      "env_vars": [
        "BENCHPOD_CONNECTION",
        "BENCHPOD_LA_VOLTAGE",
        "BENCHPOD_API_KEY",
        "BENCHPOD_API_BASE"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 3720
    }
  }
}
