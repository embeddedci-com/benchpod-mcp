#!/bin/sh
# Starts the BenchPod MCP server with uvx. Without uv on PATH it installs a private copy into the
# plugin's data folder first (no sudo, shell profile untouched); uv then fetches its own Python.
# stdout is the MCP stream: everything else goes to stderr.
SPEC='embeddedci-mcp>=2.8,<3'

if command -v uvx >/dev/null 2>&1; then
  exec uvx --from "$SPEC" embeddedci-mcp
fi

DATA="${CLAUDE_PLUGIN_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/benchpod-mcp}"
UV_DIR="$DATA/uv"

if [ ! -x "$UV_DIR/uvx" ]; then
  echo "benchpod: uv not found on PATH, installing a private copy in $UV_DIR" >&2
  TMP="$UV_DIR.tmp.$$"
  rm -rf "$TMP"
  mkdir -p "$TMP" || exit 1
  if command -v curl >/dev/null 2>&1; then
    curl -LsSf https://astral.sh/uv/install.sh | UV_UNMANAGED_INSTALL="$TMP" sh >&2
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://astral.sh/uv/install.sh | UV_UNMANAGED_INSTALL="$TMP" sh >&2
  fi
  if [ -x "$TMP/uvx" ]; then
    # Another session may have finished first; either copy works.
    mv "$TMP" "$UV_DIR" 2>/dev/null || rm -rf "$TMP"
  else
    rm -rf "$TMP"
    echo "benchpod: could not install uv. Install it yourself: https://docs.astral.sh/uv/getting-started/installation/" >&2
    exit 1
  fi
fi

exec "$UV_DIR/uvx" --from "$SPEC" embeddedci-mcp
